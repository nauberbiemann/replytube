# Chave da OpenAI para utilizar o modelo gpt-4o-mini gratuito com seus tokens diários
OPENAI_API_KEY=sua_chave_aqui

# Modelo padrão (gpt-4o-mini já inclui visão computacional para ler os prints dos comentários)
OPENAI_MODEL=gpt-4o-mini

# Senha de proteção de acesso (defina uma senha para que ninguém consuma seus tokens sem permissão)
APP_PASSWORD=minhasenha123
